{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "coverage",
    "upcoming_events",
    "suggestions"
  ],
  "properties": {
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "status",
          "note"
        ],
        "properties": {
          "source": {
            "enum": [
              "gmail",
              "notion",
              "slack",
              "calendar",
              "github",
              "linear"
            ]
          },
          "status": {
            "enum": [
              "ok",
              "partial",
              "failed"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "why",
          "sources",
          "urgency",
          "effort",
          "kind",
          "linear_draft",
          "confidence"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "url",
                "excerpt"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "gmail",
                    "notion",
                    "slack",
                    "calendar",
                    "github",
                    "linear"
                  ]
                },
                "url": {
                  "type": "string"
                },
                "excerpt": {
                  "type": "string"
                }
              }
            }
          },
          "urgency": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "effort": {
            "enum": [
              "small",
              "medium",
              "large"
            ]
          },
          "kind": {
            "enum": [
              "code",
              "reply",
              "meeting_prep",
              "follow_up",
              "other"
            ]
          },
          "linear_draft": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "team",
              "title",
              "description",
              "due"
            ],
            "properties": {
              "team": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "due": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "upcoming_events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
