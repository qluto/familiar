{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "coverage",
    "upcoming_events",
    "suggestions",
    "revisions"
  ],
  "properties": {
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "status",
          "note"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "partial",
              "failed"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "why",
          "sources",
          "urgency",
          "effort",
          "kind",
          "details",
          "confidence",
          "due"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "url",
                "excerpt"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "excerpt": {
                  "type": "string"
                }
              }
            }
          },
          "urgency": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "effort": {
            "enum": [
              "small",
              "medium",
              "large"
            ]
          },
          "kind": {
            "enum": [
              "code",
              "reply",
              "meeting_prep",
              "follow_up",
              "other"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "details": {
            "type": "string"
          },
          "due": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "upcoming_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        }
      }
    },
    "revisions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "id",
          "reason",
          "title",
          "why",
          "details",
          "urgency",
          "due"
        ],
        "properties": {
          "action": {
            "enum": [
              "retire",
              "update"
            ]
          },
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "why": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "type": [
              "string",
              "null"
            ]
          },
          "urgency": {
            "enum": [
              "low",
              "medium",
              "high",
              null
            ]
          },
          "due": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
