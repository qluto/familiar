{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "familiar",
  "version": "0.1.2",
  "identifier": "io.qluto.familiar",
  "build": {
    "frontendDist": "../web",
    "beforeBuildCommand": "bash prepare-bundle.sh"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "familiar",
        "width": 280,
        "height": 373,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "acceptFirstMouse": true,
        "visible": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "bubble",
        "title": "bubble",
        "url": "bubble.html",
        "width": 300,
        "height": 72,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "panel",
        "title": "提案",
        "url": "panel.html",
        "width": 500,
        "height": 420,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "notch",
        "title": "notch",
        "url": "notch.html",
        "width": 320,
        "height": 38,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "acceptFirstMouse": true,
        "visible": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "settings",
        "title": "familiar の設定",
        "url": "settings.html",
        "width": 500,
        "height": 180,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "setup",
        "title": "対話で設定",
        "url": "setup.html",
        "width": 500,
        "height": 460,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "Developer ID Application: Ryosuke Fukazawa (RS9ESGN72R)"
    },
    "externalBin": [
      "binaries/familiar"
    ],
    "resources": {
      "../../prompts/": "prompts/"
    }
  }
}
